{
	"name": "obsidian-copy-as-context",
	"version": "0.1.1",
	"private": true,
	"description": "Obsidian plugin: copy the selected text as context for AI, with note path, line numbers and heading path",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "vitest run",
		"install-plugin": "node scripts/install.mjs"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
}
